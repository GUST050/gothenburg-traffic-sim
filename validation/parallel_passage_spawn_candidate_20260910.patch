+def _refine_worker(task):
+    """Importable spawn target; no callback in __main__ or forked native state."""
+    arguments, measurement_workers = task
+    began = time.perf_counter()
+    value = _refine(*arguments, measurement_workers=measurement_workers)
+    return value, time.perf_counter() - began
+
+
+def _refine_tasks(tasks, variant_workers):
+    if isinstance(variant_workers, bool) or not isinstance(variant_workers, int) or variant_workers < 1:
+        raise ValueError('variant_workers must be a positive integer')
+    slots = min(6, os.cpu_count() or 1)
+    workers = min(variant_workers, len(tasks), slots)
+    if workers <= 1:
+        return [_refine_worker((task, slots)) for task in tasks]
+    # Each child owns a disjoint stage. Sum of child SUMO limits <= six.
+    # The parent receives every successful result before replacing any route.
+    with ProcessPoolExecutor(max_workers=workers,
+                             mp_context=multiprocessing.get_context('spawn')) as pool:
+        return list(pool.map(_refine_worker, [(task, slots // workers) for task in tasks]))
+
