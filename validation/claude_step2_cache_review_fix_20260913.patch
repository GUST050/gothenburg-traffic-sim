+def _refresh_edge_geometry(stat_key: tuple[int, int]):
+    """Cache arrays and a digest derived from the same file bytes."""
+    global _EDGE_GEOMETRY_CACHE
+    raw = GEO_PATH.read_bytes()
+    digest = hashlib.sha256(raw).hexdigest()
+    edge_latlon, sensor_edge_ids, edge_len_m = _geometry_from_document(
+        json.loads(raw))
+    _EDGE_GEOMETRY_CACHE = (
+        stat_key, digest, edge_latlon, sensor_edge_ids, edge_len_m)
+    return edge_latlon, sensor_edge_ids, edge_len_m
+
+
+def load_edge_geometry() -> tuple[dict[str, tuple[float, float]],
+                                  set[str], dict[str, float]]:
+    """Parse GEO_PATH once per process: edge midpoints as (lat, lon),
+    measured-edge ids, and polyline lengths in metres.
+
+    THE shared geometry source for the destination-bias guard chain
+    (_route_structure_metrics and structure_groups_for_shapes) — one parse,
+    one midpoint convention, so the enforced PFE cap and the drift metric
+    can never disagree about where an edge is. Cached on the file's
+    (mtime, size), not unconditionally: serve.py-driven recalibrations can
+    rewrite network.geojson while a process lives."""
+    global _EDGE_GEOMETRY_CACHE
+    st = GEO_PATH.stat()
+    key = (st.st_mtime_ns, st.st_size)
+    if _EDGE_GEOMETRY_CACHE is not None and _EDGE_GEOMETRY_CACHE[0] == key:
+        return (_EDGE_GEOMETRY_CACHE[2], _EDGE_GEOMETRY_CACHE[3],
+                _EDGE_GEOMETRY_CACHE[4])
+    return _refresh_edge_geometry(key)
+
+
+def _content_bound_edge_geometry():
+    """Return arrays proven to originate from the reported content digest."""
+    edge_latlon, sensor_edge_ids, edge_len_m = load_edge_geometry()
+    digest = _file_sha256(GEO_PATH)
+    if _EDGE_GEOMETRY_CACHE[1] != digest:
+        stat = GEO_PATH.stat()
+        edge_latlon, sensor_edge_ids, edge_len_m = _refresh_edge_geometry(
+            (stat.st_mtime_ns, stat.st_size))
+        digest = _EDGE_GEOMETRY_CACHE[1]
+    return digest, edge_latlon, sensor_edge_ids, edge_len_m
+
+
+def _report_input_identity(route_path: Path) -> tuple:
+    """Bind a cached pool report to every file it reads."""
+    route_path = route_path.resolve()
+    sidecars = [
+        route_path.with_name(route_path.name.replace(".rou.xml", ".agents.json")),
+        route_path.with_name(route_path.name.replace(".rou.xml", ".meta.json")),
+        Path("sumo/trip_length_fit.json").resolve(),
+    ]
+    return (str(route_path),
+            _file_sha256(route_path) if route_path.is_file() else None,
+            tuple((str(path), _file_sha256(path) if path.is_file() else None)
+                  for path in sidecars))
+
