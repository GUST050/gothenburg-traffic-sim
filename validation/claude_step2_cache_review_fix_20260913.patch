+        stat = path.stat()
+
+        changed = json.loads(path.read_text())
+        for feature in changed["features"]:
+            feature["properties"]["sensor_id"] = (
+                1 if feature["properties"]["id"] == "T" else 0)
+        rewritten = json.dumps(changed, sort_keys=True)
+        assert len(rewritten.encode()) == stat.st_size
+        path.write_text(rewritten)
+        os.utime(path, ns=(stat.st_atime_ns, stat.st_mtime_ns))
