# OS / editor
.DS_Store
.vscode/
.claude/

# Python
__pycache__/
*.pyc
.pytest_cache/

# OSMnx download cache (rebuildable; ~MBs of raw API responses)
cache/
.osmnx_cache/

# Archived pre-rewrite web experiment — never restore over web/
archive/

# Redundant human-readable dump of flow_matrix.npz (1.7 MB, rebuildable)
web/data/features/flow_matrix.csv

# SUMO intermediates (rebuildable via make sumo-net/demand/scenario);
# the web-facing products live in web/data/scenarios/ and ARE tracked
sumo/

# dirsplit: raw hourly volumes are large and re-fetchable (open APIs);
# station metadata, matches and coverage report ARE tracked
data/dirsplit/volumes/
data/dirsplit/graphs/
data_in/deso/osm_pois.geojson
data_in/deso/osm_buildings.geojson

# Run registry (PLAN.md E1): immutable per-run artifact dirs — large,
# machine-local, reproducible from their manifests; never tracked
runs/
# E2 recalibration staging (serve.py builds the new scenario set here,
# validates, then atomically publishes into web/data/scenarios/)
web/data/scenarios_staging/

# Local measured campaign evidence — preserved on disk, never committed
validation/scenario_phase_profile_report_*.json
validation/*_outcome/
validation/online_latency_baseline_v1/

# Restored evidence: `gunzip -k` on a compressed pure-archive artifact writes
# the multi-MB original back into the tracked validation/ tree. Keep the .gz
# as the committed form so a restore cannot be re-committed by `git add -A`.
validation/**/raw_*.json
